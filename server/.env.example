# =============================================================
# Dental Voice Receptionist — Infrastructure Environment Variables
# Copy this file to .env and fill in the values.
#
# NOTE: All provider API keys (Anthropic, Deepgram, Inworld, Telnyx,
# SendGrid, Google OAuth) are managed in the dashboard UI — Settings →
# API Keys. Only the infrastructure variables below belong in .env.
# =============================================================

# --- Server ---
PORT=3001
NODE_ENV=production
LOG_LEVEL=info

# --- Database (local Docker Postgres — auto-wired by docker-compose) ---
# DATABASE_URL=postgresql://dental:your_password@db:5432/dental_voice

# --- Encryption key for secrets stored in the database ---
# MUST stay in .env (cannot be stored in the DB it protects).
# Auto-generated on first run if absent.
# Generate manually: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY=

# --- JWT secret for auth sessions ---
# Auto-generated on first run if absent.
# JWT_SECRET=

# --- Public base URL (your ngrok / cloudflared tunnel URL) ---
# Required so Telnyx can reach your webhooks. Example:
#   BASE_URL=https://abc123.ngrok.io
# BASE_URL=

# --- Simulation mode ---
# true  = no real calls, SMS, or emails (safe for local dev/testing)
# false = production mode (requires provider keys set in dashboard)
SIMULATION_MODE=true

# --- CORS allowed origin (your frontend URL) ---
# CORS_ORIGIN=http://localhost:3000

# --- Optional: Sentry error tracking ---
# SENTRY_DSN=
